{
  "name": "aangan-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend for Aangan - A real-time, emotionally intelligent campus platform",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "test": "npm run typecheck:test && vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov",
    "test:unit": "vitest run --config vite.config.js",
    "test:type": "tsc --noEmit --project tsconfig.test.json",
    "test:component": "cypress open --component",
    "test:component:ci": "cypress run --component",
    "test:e2e": "start-server-and-test dev http://localhost:5173 cypress:run",
    "test:e2e:open": "start-server-and-test dev http://localhost:5173 cypress:open",
    "test:visual": "percy exec -- cypress run --spec 'cypress/e2e/visual-regression/**/*.cy.ts'",
    "test:visual:ci": "percy exec -- cypress run --headless --spec 'cypress/e2e/visual-regression/**/*.cy.ts'",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "coverage:report": "nyc report --reporter=lcov --reporter=text --reporter=html",
    "coverage:ci": "CYPRESS_COVERAGE=true start-server-and-test 'vite --port 5173' http://localhost:5173 'cypress run --env coverage=true' && npm run coverage:report",
    "test:all": "npm run test:type && npm run test:unit && npm run test:component:ci && npm run test:e2e && npm run test:visual:ci",
    "test:performance": "lighthouse http://localhost:4173 --output-path=./lighthouse-report.html --view --chrome-flags='--headless'",
    "test:load": "k6 run k6/smoke-test.js",
    "test:load:ci": "k6 run --out json=test-results.json k6/smoke-test.js"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "resolutions": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-toast": "^1.2.14",
    "@react-oauth/google": "^0.12.2",
    "@tanstack/react-query": "^5.56.2",
    "@types/jwt-decode": "^2.2.1",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.0.6",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.534.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^3.3.1",
    "web-vitals": "^5.0.3",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.12.0",
    "lighthouse": "^10.0.0",
    "k6": "^0.0.0",
    "@loadimpact/k6": "^0.0.0",
    "@cypress/code-coverage": "^3.12.18",
    "@cypress/vite-dev-server": "^6.1.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/istanbul-lib-coverage": "^2.0.4",
    "istanbul-lib-coverage": "^3.2.0",
    "nyc": "^15.1.0",
    "vite-plugin-istanbul": "^5.0.0",
    "@chromatic-com/storybook": "^3.0.9",
    "@rollup/plugin-terser": "^0.4.4",
    "@storybook/addon-a11y": "^7.6.17",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^7.6.17",
    "@storybook/addon-links": "^7.6.17",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^9.1.2",
    "@storybook/react-vite": "^9.1.2",
    "@storybook/test": "^7.6.17",
    "@storybook/test-runner": "^0.23.0",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/find-cache-dir": "^3.2.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.19.9",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/react-window": "^1.8.8",
    "@types/testing-library__user-event": "^4.1.1",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-basic-ssl": "^1.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "chromatic": "^11.8.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "lovable-tagger": "^1.0.0",
    "esbuild": "^0.25.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "sonner": "^2.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.0",
    "vite-plugin-image-optimizer": "^2.0.2",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^3.2.4"
  }
}
